generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  PENDING
  ID_UPLOADED
  VISUALLY_VERIFIED
  VISUALLY_REJECTED
  MANUALLY_VERIFIED
  MANUALLY_REJECTED
  EXPIRED
}

enum BusinessStatus {
  ACTIVE
  BLOCKED
}

model Business {
  id             String         @id @default(uuid())
  name           String
  // Portal login. Nullable so businesses provisioned before the portal existed
  // (via POST /admin/businesses or the seed CLI) keep working with just an API key.
  email          String?        @unique
  passwordHash   String?
  apiKeyHash     String         @unique
  apiKeyPreview  String?
  webhookUrl     String?
  status         BusinessStatus @default(ACTIVE)
  blockedAt      DateTime?
  blockedReason  String?
  lastLoginAt    DateTime?
  createdAt      DateTime       @default(now())

  verificationRequests VerificationRequest[]
}

model VerificationRequest {
  id                String             @id @default(uuid())
  token             String             @unique
  businessId        String
  business          Business           @relation(fields: [businessId], references: [id])
  customerType      String
  customerId        String
  status            VerificationStatus @default(PENDING)
  frontImagePath    String?
  backImagePath     String?
  ocrConfidence     Float?
  ocrExtractedText  Json?
  rejectionReason   String?
  expiresAt         DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  statusEvents StatusEvent[]

  @@index([businessId])
  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model StatusEvent {
  id                     String               @id @default(uuid())
  verificationRequestId  String
  verificationRequest    VerificationRequest  @relation(fields: [verificationRequestId], references: [id])
  status                 VerificationStatus
  label                  String
  actor                  String
  note                   String?
  createdAt              DateTime             @default(now())

  @@index([verificationRequestId])
  @@index([createdAt])
}
