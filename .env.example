# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# --- Database ---
POSTGRES_USER=drawaid
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=drawaid

# --- App ---
# Long random secret used to authenticate admin-only endpoints (creating businesses).
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=change-me-admin-token

# Long random secret that signs portal / super-admin login cookies
# (openssl rand -hex 32). If unset it is derived from ADMIN_TOKEN, which works
# but means rotating one secret rotates the other.
SESSION_SECRET=change-me-session-secret

# Product name shown in the portal, the super-admin dashboard and the API docs.
BRAND_NAME=DRAWAID

# Set to false to close public company registration (you can still create
# businesses yourself via POST /admin/businesses).
SIGNUP_ENABLED=true

# Publicly reachable base URL of this DRAWAID instance - used to build the
# QR code / capture link customers scan. Must be HTTPS in production.
PUBLIC_BASE_URL=https://drawaid.example.com

# Minutes a QR/capture link stays valid before it expires.
TOKEN_TTL_MINUTES=30

# Max upload size per image, in bytes (default 10MB).
MAX_UPLOAD_BYTES=10485760

# Minimum average OCR confidence (0-100) required to auto-pass visual verification.
OCR_MIN_CONFIDENCE=55

# Image the deploy workflow pulls on the VPS (set by CI to the GHCR image it
# just built and pushed). For pure local development this can be left as-is;
# `docker compose build` will build it from ./server regardless.
APP_IMAGE=ghcr.io/your-org/drawaid:latest

# --- Caddy (production reverse proxy / automatic HTTPS) ---
# Domain Caddy will request a Let's Encrypt certificate for. Must have DNS
# pointed at this VPS. Only used when running with `--profile prod`.
DOMAIN=drawaid.example.com
